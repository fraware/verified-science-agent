{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-science-agent.org/schemas/benchmark_task/v1.0.0",
  "title": "BenchmarkTaskSuite",
  "description": "Governance schema for VSA offline benchmark tasks: provenance-complete, categorized, and holdout-safe.",
  "type": "object",
  "required": ["tasks"],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/BenchmarkTask" }
    }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "required": ["origin", "curator", "date"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "description": "Where the task content originated (database, paper, synthetic, etc.)"
        },
        "curator": {
          "type": "string",
          "minLength": 1,
          "description": "Curator or team responsible for the task"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date the task was curated"
        }
      }
    },
    "TaskFlags": {
      "type": "object",
      "required": [
        "ambiguity",
        "contradiction",
        "metadata_only",
        "source_substitution",
        "unavailable_source",
        "temporal_cutoff"
      ],
      "additionalProperties": false,
      "properties": {
        "ambiguity": { "type": "boolean" },
        "contradiction": { "type": "boolean" },
        "metadata_only": { "type": "boolean" },
        "source_substitution": { "type": "boolean" },
        "unavailable_source": { "type": "boolean" },
        "temporal_cutoff": { "type": "boolean" }
      }
    },
    "ExpectedOutputs": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of expected task outcome"
        },
        "validation_passed": { "type": "boolean" },
        "min_evidence": { "type": "integer", "minimum": 0 },
        "min_claims": { "type": "integer", "minimum": 0 },
        "required_warning_tokens": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "BenchmarkTask": {
      "type": "object",
      "required": [
        "task_id",
        "input_question",
        "provenance",
        "license",
        "expected_outputs",
        "scoring_rationale",
        "domain",
        "flags"
      ],
      "additionalProperties": true,
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "input_question": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "license": { "type": "string", "minLength": 1 },
        "expected_outputs": { "$ref": "#/$defs/ExpectedOutputs" },
        "scoring_rationale": { "type": "string", "minLength": 1 },
        "domain": {
          "type": "string",
          "enum": [
            "genomics",
            "protein",
            "literature",
            "materials",
            "chemistry",
            "drug_target",
            "cross_domain",
            "adversarial"
          ]
        },
        "flags": { "$ref": "#/$defs/TaskFlags" },
        "task_categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "task_category": { "type": "string" },
        "task_class": { "type": "string" },
        "expected_evidence_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_claim_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_review_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gold_labels": { "type": "object" },
        "fixture_task_id": { "type": "string" },
        "fixture_report_id": { "type": "string" },
        "use_fixture_report": { "type": "boolean" },
        "expect_pass": { "type": "boolean" },
        "expect_validation_fail": { "type": "boolean" },
        "expect_contradictions": { "type": "boolean" },
        "expect_no_contradictions": { "type": "boolean" },
        "expect_ambiguity_surfaced": { "type": "boolean" },
        "expect_metadata_warning": { "type": "boolean" },
        "expect_source_substitution": { "type": "boolean" },
        "expect_unavailable_source": { "type": "boolean" },
        "expect_temporal_cutoff": { "type": "boolean" },
        "expect_predicted_structure_label": { "type": "boolean" },
        "check_hash_stable": { "type": "boolean" },
        "check_bundle_reproducible": { "type": "boolean" },
        "check_audit_stable": { "type": "boolean" },
        "verify_hashes": { "type": "boolean" },
        "allow_missing_fixture": { "type": "boolean" },
        "allow_empty_evidence": { "type": "boolean" }
      }
    }
  }
}
