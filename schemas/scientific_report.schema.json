{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-science-agent.org/schemas/scientific_report/v1.3.0",
  "title": "ScientificReport",
  "description": "Canonical artifact model for evidence-backed scientific AI reports.",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "created_at",
    "subject",
    "claims",
    "evidence",
    "methods",
    "provenance",
    "validation_results",
    "human_review",
    "generated_outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this schema (e.g. 1.0.0)."
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Claim" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Evidence" }
    },
    "methods": {
      "type": "array",
      "items": { "$ref": "#/$defs/Method" }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "validation_results": {
      "$ref": "#/$defs/ValidationResults"
    },
    "human_review": {
      "$ref": "#/$defs/HumanReview"
    },
    "generated_outputs": {
      "$ref": "#/$defs/GeneratedOutputs"
    },
    "contradictions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Contradiction" }
    },
    "input_question": { "type": "string" },
    "domain": { "type": "string" },
    "retrieval_plan": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retrieval_warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retrieval_status": {
      "type": "string",
      "enum": ["complete", "partial", "failed"],
      "description": "Typed retrieval outcome so connector failure is not inferred as empty evidence."
    },
    "connector_outcomes": {
      "type": "array",
      "description": "Per-connector typed retrieval outcomes (success, empty_result, failures, skips).",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "connector": { "type": "string" },
          "status": { "type": "string" },
          "code": { "type": ["string", "null"] },
          "evidence_count": { "type": "integer" },
          "warning": { "type": ["string", "null"] },
          "details": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "domain_pack": {
      "type": "string",
      "description": "Optional domain pack name selecting connector routing and review policy."
    },
    "evidence_selection_method": { "type": "string" },
    "claim_generation_method": { "type": "string" },
    "review_policy": { "type": "string" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_records": {
      "type": "array",
      "description": "Immutable SourceRecord authority; evidence is a view over these digests.",
      "items": { "$ref": "#/$defs/SourceRecord" }
    },
    "claim_evidence_graph": {
      "type": "object",
      "description": "First-class claim–evidence graph for validation (not render-only).",
      "additionalProperties": true,
      "properties": {
        "schema": { "type": "string" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "Subject": {
      "type": "object",
      "required": ["entity_type", "display_name"],
      "additionalProperties": true,
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "variant",
            "gene",
            "protein",
            "disease",
            "paper",
            "material",
            "molecule",
            "target",
            "experiment",
            "chemical"
          ]
        },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "gene_symbol": { "type": "string" },
        "variant_hgvs_c": { "type": "string" },
        "variant_hgvs_p": { "type": "string" },
        "transcript": { "type": "string" },
        "protein_accession": { "type": "string" },
        "doi": { "type": "string" },
        "pmid": { "type": "string" },
        "material_id": { "type": "string" },
        "condition_or_context": { "type": "string" },
        "identifiers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "source_name",
        "source_type",
        "identifier",
        "retrieval_path",
        "retrieved_at",
        "summary",
        "raw_record_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_name": { "type": "string", "minLength": 1 },
        "source_type": {
          "type": "string",
          "enum": [
            "database",
            "publication",
            "structure",
            "benchmark",
            "guideline",
            "experiment",
            "preprint"
          ]
        },
        "identifier": { "type": "string", "minLength": 1 },
        "retrieval_path": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1 },
        "raw_record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "description": "Link to authoritative SourceRecord.source_id"
        },
        "evidence_role": {
          "type": "string",
          "enum": ["supports", "contradicts", "contextualizes"]
        },
        "reliability": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "quality_score": { "$ref": "#/$defs/QualityScore" },
        "domain_metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "SourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "canonical_url",
        "accession",
        "retrieved_at",
        "content_digest",
        "media_type",
        "query",
        "raw_response_retention",
        "license",
        "connector",
        "transformation_history",
        "source_availability"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": "string" },
        "accession": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "database_version": { "type": ["string", "null"] },
        "query": { "type": "object", "additionalProperties": true },
        "raw_response_retention": {
          "type": "string",
          "enum": ["retained", "digest_only", "unavailable"]
        },
        "license": { "type": "string", "minLength": 1 },
        "connector": { "type": "string", "minLength": 1 },
        "transformation_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "at", "digest_in", "digest_out"],
            "properties": {
              "op": { "type": "string" },
              "at": { "type": "string" },
              "digest_in": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "digest_out": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "source_availability": {
          "type": "string",
          "enum": ["available", "cached", "unavailable", "substituted"]
        }
      }
    },
    "QualityScore": {
      "type": "object",
      "required": ["score", "reasons"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Claim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_type",
        "claim_text",
        "claim_text_normalized",
        "supporting_evidence_ids",
        "contradicting_evidence_ids",
        "evidence_ids",
        "confidence",
        "confidence_semantics",
        "review_boundary",
        "uncertainty_level",
        "inference_method",
        "source_spans",
        "validation_result",
        "reviewer_status"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "claim_type": {
          "type": "string",
          "enum": [
            "identity",
            "classification",
            "observation",
            "mechanism",
            "comparison",
            "hypothesis",
            "summary",
            "structure",
            "property"
          ]
        },
        "claim_text": { "type": "string", "minLength": 10 },
        "claim_text_normalized": {
          "type": "string",
          "description": "Whitespace/case-normalized claim_text for stable comparison"
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence IDs that support the claim; empty only when review_boundary=unsupported"
        },
        "contradicting_evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Compatibility union of supporting and contradicting evidence IDs"
        },
        "source_spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceSpan" }
        },
        "inference_method": {
          "type": "string",
          "enum": ["direct_extract", "rule", "llm", "aggregation", "human", "unknown"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_semantics": {
          "type": "object",
          "required": ["scale", "min", "max", "interpretation"],
          "additionalProperties": true,
          "properties": {
            "scale": { "type": "string" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "interpretation": { "type": "string", "minLength": 1 }
          }
        },
        "validation_result": {
          "type": "object",
          "required": ["status", "check_ids"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pending", "pass", "warn", "fail"]
            },
            "check_ids": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "reviewer_status": {
          "type": "string",
          "enum": ["unreviewed", "approved", "rejected", "needs_revision"]
        },
        "review_boundary": {
          "type": "string",
          "enum": [
            "safe_summary",
            "requires_domain_review",
            "requires_clinical_review",
            "speculative",
            "unsupported"
          ]
        },
        "uncertainty_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "unknown"]
        },
        "support_level": {
          "type": "string",
          "enum": ["high", "medium", "low", "insufficient"]
        }
      }
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "evidence_id", "start", "end", "quote_hash"],
      "properties": {
        "source_id": { "type": "string" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "quote_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "Method": {
      "type": "object",
      "required": ["method_id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "method_id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "Provenance": {
      "type": "object",
      "required": [
        "source_record_hashes",
        "evidence_bundle_hash",
        "claim_hashes",
        "report_hash",
        "validation_version",
        "renderer_version"
      ],
      "additionalProperties": false,
      "properties": {
        "source_record_hashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "evidence_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "claim_hashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "report_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validation_run_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validation_version": { "type": "string" },
        "renderer_version": { "type": "string" },
        "generated_by": {
          "type": "object",
          "properties": {
            "system_name": { "type": "string" },
            "model_or_agent_stack": { "type": "string" },
            "run_id": { "type": "string" },
            "prompt_template_version": { "type": "string" },
            "human_reviewer": { "type": "string" },
            "llm_provider": { "type": "string" },
            "llm_model": { "type": "string" }
          }
        },
        "review_chain_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "review_event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signature": {
          "type": "object",
          "required": ["algorithm", "public_key_b64", "signature_b64", "signed_at", "payload"],
          "properties": {
            "algorithm": { "type": "string", "enum": ["ed25519"] },
            "public_key_b64": { "type": "string" },
            "signature_b64": { "type": "string" },
            "signed_at": { "type": "string", "format": "date-time" },
            "payload": { "type": "string" }
          }
        },
        "reproducibility": {
          "type": "object",
          "properties": {
            "input_hash": { "type": "string" },
            "cache_dir": { "type": "string" },
            "instructions": { "type": "string" }
          }
        }
      }
    },
    "ValidationResults": {
      "type": "object",
      "required": ["status", "checks"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "warn", "fail"]
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValidationCheck" }
        },
        "validated_at": { "type": "string", "format": "date-time" }
      }
    },
    "ValidationCheck": {
      "type": "object",
      "required": ["check_id", "name", "status", "message"],
      "additionalProperties": false,
      "properties": {
        "check_id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "message": { "type": "string" }
      }
    },
    "HumanReview": {
      "type": "object",
      "required": ["required", "status"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "approved",
            "rejected",
            "needs_revision",
            "not_required"
          ]
        },
        "reviewer_identity": { "type": "string" },
        "review_timestamp": { "type": "string", "format": "date-time" },
        "review_decision": { "type": "string" },
        "required_corrections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approved_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReviewEvent" }
        }
      }
    },
    "ReviewEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "reviewer_identity",
        "decision",
        "prior_event_digest"
      ],
      "properties": {
        "timestamp": { "type": "string" },
        "reviewer_identity": { "type": "string", "minLength": 1 },
        "reviewer": {
          "type": "string",
          "description": "Legacy alias for reviewer_identity"
        },
        "claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "decision": { "type": "string", "minLength": 1 },
        "action": {
          "type": "string",
          "description": "Legacy alias for decision"
        },
        "rationale": { "type": "string" },
        "notes": {
          "type": "string",
          "description": "Legacy alias for rationale"
        },
        "corrections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "prior_event_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of previous event; genesis uses 64 zero hex digits"
        },
        "signature": {
          "type": "string",
          "description": "Optional detached signature over the event payload"
        },
        "unsigned_status": {
          "type": "string",
          "const": "unsigned",
          "description": "Present when the event is intentionally unsigned"
        }
      }
    },
    "GeneratedOutputs": {
      "type": "object",
      "required": ["formats_available"],
      "additionalProperties": false,
      "properties": {
        "formats_available": {
          "type": "array",
          "items": { "type": "string", "enum": ["json", "markdown", "html", "pdf"] }
        },
        "markdown_path": { "type": "string" },
        "html_path": { "type": "string" },
        "pdf_path": { "type": "string" }
      }
    },
    "Contradiction": {
      "type": "object",
      "required": ["contradiction_id", "claim_ids", "evidence_ids", "description", "severity"],
      "additionalProperties": false,
      "properties": {
        "contradiction_id": { "type": "string" },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    }
  }
}
