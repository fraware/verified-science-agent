{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-science-agent.local/schemas/akta_action_context.schema.json",
  "title": "AktaActionContext",
  "description": "Stable export AKTA consumes without field-guessing. Explicitly non-authorizing. VSA does not authorize actions, execute tools, issue grants, or certify scientific correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "proposed_action",
    "supporting_claim_refs",
    "contradicting_claim_refs",
    "evidence_levels",
    "uncertainty",
    "missing_evidence",
    "digests",
    "known_domain_limits",
    "suggested_next_evidence_steps",
    "candidate_execution",
    "authorization",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context_id": { "type": "string", "minLength": 1 },
    "evidence_report_id": { "type": ["string", "null"] },
    "bundle_id": { "type": ["string", "null"] },
    "decision_time_cutoff": { "type": ["string", "null"] },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "action_class", "description"],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "action_class": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "supporting_claim_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contradicting_claim_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "support_level", "confidence"],
        "properties": {
          "claim_id": { "type": "string" },
          "support_level": { "type": "string" },
          "confidence": { "type": "number" },
          "uncertainty_level": { "type": ["string", "null"] }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "items"],
      "properties": {
        "summary": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_hash", "schema_digest"],
      "properties": {
        "report_hash": { "type": ["string", "null"] },
        "bundle_hash": { "type": ["string", "null"] },
        "schema_digest": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "known_domain_limits": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_next_evidence_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidate_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_or_execution_class", "note"],
      "properties": {
        "tool_or_execution_class": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "authorization": {
      "type": "string",
      "const": "none"
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizes_actions",
        "executes_tools",
        "issues_grants",
        "certifies_scientific_correctness"
      ],
      "properties": {
        "authorizes_actions": { "type": "boolean", "const": false },
        "executes_tools": { "type": "boolean", "const": false },
        "issues_grants": { "type": "boolean", "const": false },
        "certifies_scientific_correctness": { "type": "boolean", "const": false }
      }
    }
  }
}
